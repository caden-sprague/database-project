############################################################


############################################################
# PostgreSQL Configuration
############################################################

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=proj

############################################################
# Optional - Port Customization (Uncomment if needed)
# Use these only if default ports conflict with
# a local installation on your machine.
############################################################

# MYSQL_PORT=3306
# POSTGRES_PORT=5432
# ORACLE_PORT=1521